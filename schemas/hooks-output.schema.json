{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-exit/hook-output/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "veto": { "type": "boolean" },
    "reason": { "type": "string" },
    "evidence_proposals": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
    "amendment_proposals": { "type": "array", "maxItems": 64, "items": { "type": "object" } }
  }
}
