{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Know-Me-Tools/phase-exit/schemas/contract.schema.json",
  "title": "Phase Exit contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project",
    "phase",
    "exclusions",
    "prerequisites",
    "boundary",
    "retry_limits",
    "jev",
    "revision",
    "parent_digest",
    "identity",
    "sources",
    "conflicts",
    "stages",
    "criteria",
    "actions",
    "hooks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "minItems": 0
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_stages"
      ],
      "properties": {
        "implementation_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "minItems": 1
        }
      }
    },
    "retry_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_elapsed_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "rubric_version",
        "support_threshold",
        "contradiction_threshold"
      ],
      "properties": {
        "model": {
          "const": "jev-1.14.0"
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        },
        "support_threshold": {
          "type": "number",
          "minimum": 0.95,
          "maximum": 1
        },
        "contradiction_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "role": {
            "enum": [
              "assessment",
              "analysis",
              "specification",
              "plan",
              "evidence",
              "configuration"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion_ids",
          "resolution",
          "source_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "minItems": 1
          },
          "resolution": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "minItems": 0
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "kind": {
            "enum": [
              "implementation",
              "gate",
              "publication"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "description",
          "source_id",
          "depends_on",
          "expected_outcome",
          "predicate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "minItems": 0
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "const": "file_sha256"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer",
                  "expected"
                ],
                "properties": {
                  "kind": {
                    "const": "json_equals"
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "expected": {}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "action_id"
                ],
                "properties": {
                  "kind": {
                    "const": "command_success"
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer"
                ],
                "properties": {
                  "kind": {
                    "const": "external_ready"
                  },
                  "pointer": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer",
                  "question"
                ],
                "properties": {
                  "kind": {
                    "const": "semantic"
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "stage",
          "executable",
          "argv",
          "cwd",
          "repairs_criteria",
          "covers_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "kind": {
            "enum": [
              "implementation",
              "gate",
              "publication",
              "repair"
            ]
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "covers_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "minItems": 0
          },
          "repairs_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "hooks": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_path",
            "config_sha256"
          ],
          "properties": {
            "config_path": {
              "type": "string",
              "minLength": 1
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
