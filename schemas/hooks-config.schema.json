{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-exit/hooks-config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hooks"],
  "properties": {
    "schema_version": { "const": 1 },
    "hooks": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "event", "module", "sha256", "input_schema", "output_schema", "timeout_ms", "required", "env_allowlist"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "event": { "enum": ["contract.collected", "contract.frozen", "evidence.imported", "evaluation.before", "judgement.received", "decision.finalized", "amendment.proposed"] },
          "module": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "input_schema": { "const": "phase-exit/hook-input/v1" },
          "output_schema": { "const": "phase-exit/hook-output/v1" },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
          "required": { "type": "boolean" },
          "env_allowlist": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
        }
      }
    }
  },
  "$comment": "Runtime additionally rejects duplicate IDs and an event's summed timeout exceeding 45000ms. All inputs, config, each module and aggregate output are bounded to 1MiB."
}
