{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Know-Me-Tools/phase-exit/schemas/evidence.schema.json",
  "title": "Phase Exit evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_digest",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion_id",
          "contract_digest",
          "identity",
          "artifact_path",
          "artifact_sha256",
          "captured_at",
          "expires_at",
          "supersedes",
          "origin",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "contract_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "captured_at": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runner",
              "config_sha256",
              "platform",
              "artifact_identity"
            ],
            "properties": {
              "runner": {
                "type": "string",
                "minLength": 1
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "artifact_identity": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "operation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "action_id",
                  "state",
                  "started_at",
                  "expires_at"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  },
                  "state": {
                    "enum": [
                      "running",
                      "completed"
                    ]
                  },
                  "started_at": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "expires_at": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0
    }
  }
}
