{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Know-Me-Tools/phase-exit/schemas/learning.schema.json",
  "title": "Phase Exit learning v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "contract_digest",
    "kind",
    "summary",
    "evidence_refs",
    "proposed_criteria",
    "supersedes",
    "classification",
    "disposition",
    "affected_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "discovery",
        "failure",
        "learning",
        "amendment"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "minItems": 0
    },
    "proposed_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stage",
          "description",
          "source_id",
          "depends_on",
          "expected_outcome",
          "predicate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "minItems": 0
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sha256"
                ],
                "properties": {
                  "kind": {
                    "const": "file_sha256"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer",
                  "expected"
                ],
                "properties": {
                  "kind": {
                    "const": "json_equals"
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "expected": {}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "action_id"
                ],
                "properties": {
                  "kind": {
                    "const": "command_success"
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.-]+$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer"
                ],
                "properties": {
                  "kind": {
                    "const": "external_ready"
                  },
                  "pointer": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "pointer",
                  "question"
                ],
                "properties": {
                  "kind": {
                    "const": "semantic"
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      },
      "minItems": 0
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "enum": [
        "clarification",
        "in_scope_defect",
        "new_scope",
        "external_dependency",
        "deferred_improvement"
      ]
    },
    "disposition": {
      "type": "string",
      "minLength": 1
    },
    "affected_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "minItems": 0
    }
  }
}
