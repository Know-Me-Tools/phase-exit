{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Know-Me-Tools/phase-exit/schemas/adoption.schema.json",
  "title": "Phase Exit adoption v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_digest",
    "review_digest",
    "previous_contract_digest",
    "operator",
    "rationale",
    "invalidated_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_contract_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "invalidated_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "minItems": 0
    }
  }
}
