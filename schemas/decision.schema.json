{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Know-Me-Tools/phase-exit/schemas/decision.schema.json",
  "title": "Phase Exit decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "contract_digest",
    "evaluated_stage",
    "verdict",
    "stage_complete",
    "phase_complete",
    "unmet_criteria",
    "evidence_refs",
    "reasons",
    "next_authorized_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluated_stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "verdict": {
      "enum": [
        "COMPLETE",
        "CONTINUE",
        "WAIT",
        "BLOCKED",
        "REVIEW_REQUIRED",
        "INVALID"
      ]
    },
    "stage_complete": {
      "type": "boolean"
    },
    "phase_complete": {
      "type": "boolean"
    },
    "unmet_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "minItems": 0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "minItems": 0
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "criterion_id",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "next_authorized_action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "kind": {
              "enum": [
                "implementation",
                "gate",
                "publication",
                "repair"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
